# Copy this file to `.env` and fill in your values.
# Never commit or share your .env file — it contains secret keys.

# Groq AI (free) — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase — https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X (Twitter) API — only needed for Step 7 (posting to X). Leave empty for now.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Gmail SMTP — for automated outreach (send-outreach). Create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gmail API OAuth (REQUIRED for 24/7 sending from Railway — SMTP is blocked there).
# Run: node scripts/gmail-setup.js  → paste GMAIL_REFRESH_TOKEN from its output.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Serper.dev — for automated founder-hunt search (2,500 one-time queries, use sparingly)
SERPER_API_KEY=