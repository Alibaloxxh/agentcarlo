# Copy this file to `.env` and fill in your values.
# Never commit or share your .env file — it contains secret keys.

# Groq AI (free) — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase — https://supabase.com → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# X (Twitter) API — only needed for Step 7 (posting to X). Leave empty for now.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=